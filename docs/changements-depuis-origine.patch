+/* ==========================================================================
+   V2 — accessibilité des couleurs et logo (ajouts)
+   ========================================================================== */
+:root{
+  --btn:color-mix(in srgb,var(--color-primary) 90%,#000);          /* fond des boutons : texte blanc lisible (contraste > 4,5) */
+  --primary-text:color-mix(in srgb,var(--color-primary) 80%,#000);  /* texte bleu sur fond clair */
+  --secondary-dark:color-mix(in srgb,var(--color-secondary) 45%,#000);
+  --gold-dark:color-mix(in srgb,var(--color-gold) 40%,#000);
+  --sage-dark:color-mix(in srgb,var(--color-sage) 45%,#000);
+}
+.dark{--line:rgba(54,217,255,.16);--primary-text:#8DE7FF}
+/* boutons : bleu lisible en clair, cyan avec texte nuit en sombre */
+.btn-primary,.btn-primary:not(.btn-slide){background:var(--btn);border-color:var(--btn);color:#fff}
+.btn-primary:hover{background:var(--primary-active);border-color:var(--primary-active)}
+.btn.btn-slide,.btn.btn-slide:hover{background:linear-gradient(180deg,var(--btn),var(--primary-active));border-color:var(--btn);color:#fff}
+.btn-secondary{color:var(--primary-text);border-color:color-mix(in srgb,var(--color-primary) 45%,transparent)}
+.dark .btn-primary,.dark .btn.btn-slide{background:var(--color-secondary);border-color:var(--color-secondary);color:#050B18}
+.dark .btn-primary:hover,.dark .btn.btn-slide:hover{background:#7FE8FF;border-color:#7FE8FF;color:#050B18}
+.dark .btn-secondary{color:#F5F8FF;border-color:rgba(54,217,255,.4)}
+.dark .btn-secondary:hover{background:rgba(54,217,255,.1);border-color:var(--color-secondary);color:#fff}
+.text-brand-600,.app-more,.sec-tabs button:hover{color:var(--primary-text)}
+.dark .text-brand-600,.dark .text-brand-300,.dark .app-more{color:#8DE7FF}
+.text-gradient{background-image:linear-gradient(90deg,var(--primary-text),#0E8AA8)!important}
+.dark .text-gradient{background-image:linear-gradient(90deg,#78A9FF,#36D9FF)!important}
+/* panneau d'affichage : bleu nuit profond avec lueur bleue */
+.board{background:radial-gradient(120% 140% at 85% 0%,#1B5FD6 0%,#0B2F6B 42%,#050B18 100%);border:1px solid rgba(54,217,255,.28)}
